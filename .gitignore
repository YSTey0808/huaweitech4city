__pycache__/
.DS_Store

# pipeline/ -- training data stays local-only (large, not needed to serve).
# checkpoints/ is deliberately NOT ignored -- committed to git (a few MB),
# so Render's build has them without a separate fetch/LFS step.
pipeline/dataset/
pipeline/preprocess/test_pipeline.py

# pipeline/experiments/checkpoints/ -- throwaway checkpoints from one-off
# training runs (e.g. learning-curve experiments), unlike the checkpoints
# under pipeline/checkpoints/ which ARE committed. Scoped to just the
# checkpoints subfolder (not all of pipeline/experiments/) so experiment
# scripts themselves stay tracked. pipeline/reports/ (the analysis/results
# of those experiments) is deliberately NOT ignored -- that's the actual
# deliverable worth keeping.
pipeline/experiments/checkpoints/
pipeline/reports/

# backend/ -- local embedding cache, secrets, and its virtualenv
backend/data/
backend/.env
backend/.venv/

# Partner API key minting stays OFF the production server. This tool mints
# credentials for the public /v1/analyze API; keeping it out of git means the
# deploy (deploy/redeploy.sh does a `git checkout -f`) never places it on the
# VM, so key issuing only ever happens from a trusted local machine.
#
# Note this is hygiene, not a hard boundary: backend/.env on the VM already
# holds SUPABASE_SERVICE_ROLE_KEY, which can write api_keys directly. The
# point is to avoid shipping a ready-made "mint yourself a credential" tool
# to an internet-facing host.
#
# Consequence: this file lives only on the machines that already have it. If
# you need it elsewhere, copy it across manually -- a fresh clone will not
# contain it. See docs/public_api.md.
backend/scripts/mint_api_key.py

# Any local record of issued keys -- never commit plaintext credentials.
backend/scripts/*.keys
*.keys.txt

# frontend/ and supabase/ have their own .gitignore (node_modules, dist,
# .env*, Supabase CLI's .branches/.temp) -- not duplicated here.

# repo root -- the Supabase CLI was installed here as a local dev dependency
# (npm install supabase --save-dev) so `npx supabase ...` works. None of this
# belongs in git. Leading slash anchors to the root only, so frontend/'s own
# package.json / node_modules are unaffected.
/node_modules/
/package.json
/package-lock.json

pipeline/.venv/
